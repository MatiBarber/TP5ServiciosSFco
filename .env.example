# Configuracion de Firebase.
#
# Copiar este archivo como .env y completar con los valores del proyecto.
# Se obtienen en: consola de Firebase > Configuracion del proyecto > General >
# Tus apps > aplicacion web > Configuracion del SDK.
#
# Estas claves NO son secretas: viajan en el paquete de cualquier aplicacion web
# con Firebase y estan pensadas para ser publicas. Lo que protege al proyecto
# son las reglas de seguridad, no el secreto de estos valores. Aun asi .env no
# se versiona, para no dejar el identificador del proyecto en el repositorio.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Clave publica del par VAPID. Se genera en:
# Configuracion del proyecto > Cloud Messaging > Certificados push web > Generar
# par de claves. Es obligatoria para Web Push y no existe en Android.
VITE_FIREBASE_VAPID_KEY=

# Base de la API municipal. Solo se usa con USAR_SIMULADOR en false (src/config.js).
VITE_BASE_API=https://api.sanfrancisco.gob.ar/v1
